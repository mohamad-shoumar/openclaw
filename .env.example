# Copy to .env. Only the LLM key is required for artifact generation.

# One of: openai | anthropic
OPENCLAW_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional LLM overrides
# OPENCLAW_LLM_MODEL=
# OPENCLAW_LLM_TEMPERATURE=0.2
# OPENCLAW_LLM_MAX_TOKENS=2500

# Optional: enables the SerpAPI Google Jobs source
# SERPAPI_API_KEY=
